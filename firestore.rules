rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Ephemeral Blip signaling only (SDP / ICE). Never store file bytes here.
    match /blipRooms/{roomId} {
      allow read, create, update, delete: if roomId.size() >= 4 && roomId.size() <= 16;
      match /{iceCol}/{iceId} {
        allow read, create, update, delete: if roomId.size() >= 4 && roomId.size() <= 16
          && (iceCol == 'hostIce' || iceCol == 'guestIce');
      }
    }

    // Ephemeral P2P signaling (renamed from Blip). Same shape.
    match /p2pRooms/{roomId} {
      allow read, create, update, delete: if roomId.size() >= 4 && roomId.size() <= 16;
      match /{iceCol}/{iceId} {
        allow read, create, update, delete: if roomId.size() >= 4 && roomId.size() <= 16
          && (iceCol == 'hostIce' || iceCol == 'guestIce');
      }
    }

    // Linguist Guardian P2P Clash — ephemeral battle rooms (co-op boss / 1v1).
    match /battleRooms/{roomId} {
      allow read, create, update, delete: if roomId.size() == 6
        && roomId.matches('[0-9]+');
      match /{sub}/{subId} {
        allow read, create, update, delete: if roomId.size() == 6
          && roomId.matches('[0-9]+');
      }
    }

    // Online Scrabble Game — ephemeral rooms
    match /scrabbleRooms/{roomId} {
      allow read, create, update, delete: if roomId.size() == 6
        && roomId.matches('[0-9]+');
      match /{sub}/{subId} {
        allow read, create, update, delete: if roomId.size() == 6
          && roomId.matches('[0-9]+');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
