# bun (use npm on Cloudflare Pages / CI — see 4893bbe)
bun.lock
bunfig.toml

# Dependencies
node_modules/

# Production build & cache
dist/
tmp/
.wrangler/
.hermes/
.cache/

# Environment files
.env
.env.local
.env.*.local
# Build-time config carrying the Sentry DSN. The DSN is public by nature (it is
# inlined into every bundle), but it is still local build config, not source.
.env.production

croc_wasm.bin

# Local APK output. Releases are the distribution channel (the android-apk
# workflow publishes there); a copy sitting in the repo root is a 12 MB
# duplicate that only ever goes stale.
kora-android-release-*/

# Agent scratch. Already ignored above for new files, but these were tracked
# before the rule existed, so `git rm --cached` was needed to untrack them.
# Keep the plans in .hermes/plans/ — they are the design record.

# Stray downloads from live-source verification (scripts/verify-*.mts)
t.pdf
*.pdf.part
