# Copy to `.env` for local dev (never commit real ad keys).

# --- Display ads (default: off) ---
# VITE_ADS_ENABLED=true
# VITE_ADS_PROVIDER=adsterra
# VITE_ADS_ZONE_MOBILE=
# VITE_ADS_ZONE_DESKTOP=
# VITE_ADS_DESKTOP_SIZE=728x90
# VITE_ADS_SCRIPT_ORIGIN=https://www.highperformanceformat.com
# VITE_ADS_ALLOW_NATIVE=false
# VITE_ADS_CSP_EXTRA=

# Node production server + Worker (mirror VITE_ADS_ENABLED when deploying with ads):
# KORA_ADS_ENABLED=false
