# Copy to `.env` for local Capacitor / APK web builds.
# The Android APK loads bundled web assets and forwards /api/* here.

VITE_APP_CHANNEL=production
VITE_API_BASE_URL=https://YOUR-WORKER.workers.dev
VITE_SENTRY_DSN=

# Optional self-hosted RaveBSD search backend for the Cloudflare Worker.
# Configure as Worker variables/secrets in Cloudflare:
# RAVE_BOOK_SEARCH_URL=https://YOUR-RAVEBSD-HOST/api/v1/search
# RAVE_BOOK_SEARCH_API_KEY=your-server-side-api-key (Worker secret; never VITE_)
# For local `wrangler dev`, put the same values in `.dev.vars` (gitignored).
# If unset, Kora tries the legacy Rave endpoint; the public RaveBookSearch site has retired.
