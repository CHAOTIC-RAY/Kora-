# Copy to `.env` for local Capacitor / APK web builds.
# The Android APK loads bundled web assets and forwards /api/* here.

VITE_APP_CHANNEL=production
VITE_API_BASE_URL=https://YOUR-WORKER.workers.dev
VITE_SENTRY_DSN=

# --- Cloudflare Worker secrets (Rave Book Search v1 API) ---
# These are NOT read from .env by the Worker. They are Cloudflare secrets.
# Set them with:
#   wrangler secret put RAVE_API_KEY        # server-side only; never commit/expose
# For local `wrangler dev`, put them in `.dev.vars` (gitignored):
#   RAVE_API_KEY=your_key_here
# The key from the Rave Book Search PDF (X-API-Key header) MUST stay server-side.
# Without it, the Worker falls back to the legacy public Rave endpoint.
